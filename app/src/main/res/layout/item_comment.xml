<?xml version="1.0" encoding="utf-8"?>
<!-- item_comment.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="6dp"
    android:gravity="top">

    <!-- ── User avatar (Cloudinary via Glide, circleCrop) ────────────── -->
    <ImageView
        android:id="@+id/ivCommentAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="User avatar"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_avatar_bg"
        android:src="@drawable/ic_default_avatar" />

    <!-- ── Comment bubble ──────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Bubble background -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/comment_bubble_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:maxWidth="280dp">

            <!-- Name and Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/tvCommentName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/btnEditComment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit"
                    android:textSize="11sp"
                    android:textColor="@color/blue_primary"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnDeleteComment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Delete"
                    android:textSize="11sp"
                    android:textColor="#FF5252"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Comment text -->
            <TextView
                android:id="@+id/tvCommentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.3" />

            <!-- View Location Button -->
            <TextView
                android:id="@+id/btnViewLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/rounded_info_bg"
                android:drawableStart="@android:drawable/ic_menu_mylocation"
                android:drawablePadding="4dp"
                android:drawableTint="@color/blue_primary"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="View Location"
                android:textColor="@color/blue_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Timestamp below bubble -->
        <TextView
            android:id="@+id/tvCommentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginStart="4dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvCommentLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="4dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>